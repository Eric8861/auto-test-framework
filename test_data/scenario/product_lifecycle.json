{
  "product_lifecycle": {
    "name": "商品完整生命周期测试",
    "description": "测试商品从创建到上下架的完整流程",
    "steps": [
      {
        "step": 1,
        "action": "admin_login",
        "description": "后台管理员登录",
        "expected": {
          "code": 200,
          "has_token": true
        }
      },
      {
        "step": 2,
        "action": "create_product",
        "description": "后台创建商品",
        "data": {
          "name": null,
          "price": 199.0,
          "brandId": 49,
          "productCategoryId": 7,
          "stock": 100,
          "publishStatus": 0
        },
        "expected": {
          "code": 200,
          "has_product_id": true
        }
      },
      {
        "step": 3,
        "action": "verify_product_in_list",
        "description": "后台验证商品已创建",
        "expected": {
          "code": 200,
          "product_in_list": true
        }
      },
      {
        "step": 4,
        "action": "publish_product",
        "description": "后台上架商品",
        "expected": {
          "code": 200
        }
      },
      {
        "step": 5,
        "action": "portal_check_published",
        "description": "前台验证商品已上架可见",
        "expected": {
          "code": 200,
          "has_product": true,
          "publishStatus": 1
        }
      },
      {
        "step": 6,
        "action": "unpublish_product",
        "description": "后台下架商品",
        "expected": {
          "code": 200
        }
      },
      {
        "step": 7,
        "action": "portal_check_unpublished",
        "description": "前台验证商品已下架",
        "expected": {
          "code": 200
        }
      },
      {
        "step": 8,
        "action": "delete_product",
        "description": "删除测试商品",
        "expected": {
          "code": 200
        }
      }
    ]
  }
}
